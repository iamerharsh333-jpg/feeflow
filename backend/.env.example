# FeeFlow Backend Configuration

# Database (SQLite for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./feeflow.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/feeflow

# JWT Authentication
JWT_SECRET=feeflow-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Google Gemini API (Optional: rule-based fallback used if omitted)
GEMINI_API_KEY=

# Payment Gateway (Mock mode default, or Razorpay test credentials)
PAYMENT_MODE=mock
PAYMENT_GATEWAY_KEY=rzp_test_mock_key
PAYMENT_GATEWAY_SECRET=rzp_test_mock_secret

# Providers
OTP_PROVIDER=mock
MESSAGE_PROVIDER=mock

# Taxation (Configurable GST rate percentage)
GST_RATE=18.0

